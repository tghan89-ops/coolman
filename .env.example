# Postgres connection string.
# Prod: local Postgres on the droplet (postgresql://coolman:<pw>@localhost:5432/coolman)
# Dev: your own local Postgres (postgresql://coolman:coolman@localhost:5432/coolman_dev)
DATABASE_URI=

# Payload CMS secret — generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public URL of your app (no trailing slash)
# Dev: http://localhost:3000
# Prod: https://demo.coolman.com.my (later https://coolman.com.my)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Image/file storage: LOCAL DISK (Payload default, served from /opt/coolman/media).
# Vercel Blob is no longer used — leave this empty. Setting it re-enables the
# Vercel Blob plugin, which we deliberately migrated away from.
BLOB_READ_WRITE_TOKEN=

# Resend email — get from: resend.com → API Keys
RESEND_API_KEY=

# Sending domain verified in Resend (e.g. no-reply@coolman.com.my)
RESEND_FROM_EMAIL=orders@tx.coolman.com.my

# Alan's email for order notifications
ALAN_EMAIL=alan@coolman.com.my

# Shared secret for the scheduled alert job — generate with: openssl rand -base64 32
# The droplet's system cron sends this as `Authorization: Bearer <CRON_SECRET>`
# to /api/cron/unresponded-alert (replaced Vercel Cron).
CRON_SECRET=

# Comma-separated list of emails that receive the hour-23 unresponded-order alert.
# If empty, falls back to ALAN_EMAIL above.
# Example: alan@coolman.com.my,pushpa@coolman.com.my
ALERT_RECIPIENTS=
