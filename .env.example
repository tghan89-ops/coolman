# Vercel Postgres — get from: Vercel dashboard → Storage → your Postgres DB → .env.local tab
DATABASE_URI=

# Payload CMS secret — generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public URL of your app (no trailing slash)
# Dev: http://localhost:3000
# Prod: https://your-domain.vercel.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob — get from: Vercel dashboard → Storage → your Blob store → .env.local tab
# Format: vercel_blob_rw_<store_id>_<random_string>
BLOB_READ_WRITE_TOKEN=

# Resend email — get from: resend.com → API Keys
RESEND_API_KEY=

# Sending domain verified in Resend (e.g. no-reply@coolman.com.my)
RESEND_FROM_EMAIL=orders@tx.coolman.com.my

# Alan's email for order notifications
ALAN_EMAIL=alan@coolman.com.my

# Shared secret for Vercel Cron — generate with: openssl rand -base64 32
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# Comma-separated list of emails that receive the hour-23 unresponded-order alert.
# If empty, falls back to ALAN_EMAIL above.
# Example: alan@coolman.com.my,pushpa@coolman.com.my
ALERT_RECIPIENTS=
